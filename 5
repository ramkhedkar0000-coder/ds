# Event Processing Using Queue

queue = []

while True:
    print("\n--- Event Processing System ---")
    print("1. Add Event")
    print("2. Process Next Event")
    print("3. Display Pending Events")
    print("4. Cancel Event")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == '1':
        event = input("Enter event name: ")
        queue.append(event)
        print("Event added successfully!")

    elif choice == '2':
        if len(queue) > 0:
            event = queue.pop(0)
            print("Processing Event:", event)
        else:
            print("No events to process!")

    elif choice == '3':
        if len(queue) > 0:
            print("Pending Events:", queue)
        else:
            print("No pending events!")

    elif choice == '4':
        event = input("Enter event name to cancel: ")

        if event in queue:
            queue.remove(event)
            print("Event cancelled successfully!")
        else:
            print("Event not found!")

    elif choice == '5':
        print("Exiting Event Processing System...")
        break

    else:
        print("Invalid choice! Try again.")
