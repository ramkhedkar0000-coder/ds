# Call Center Queue Using Queue

queue = []

def addCall(customerID, callTime):
    call = (customerID, callTime)
    queue.append(call)
    print("Call added successfully!")

def answerCall():
    if len(queue) == 0:
        print("No calls waiting!")
    else:
        call = queue.pop(0)
        print("Answered Customer ID:", call[0])
        print("Call Time:", call[1], "minutes")

def viewQueue():
    if len(queue) == 0:
        print("Queue is empty!")
    else:
        print("Pending Calls:")
        for call in queue:
            print("Customer ID:", call[0],
                  "Call Time:", call[1], "minutes")

def isQueueEmpty():
    if len(queue) == 0:
        print("Queue is empty.")
    else:
        print("Queue is not empty.")

while True:
    print("\n--- Call Center Queue ---")
    print("1. Add Call")
    print("2. Answer Call")
    print("3. View Queue")
    print("4. Check Queue Empty")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == '1':
        customerID = input("Enter Customer ID: ")
        callTime = int(input("Enter Call Time (minutes): "))
        addCall(customerID, callTime)

    elif choice == '2':
        answerCall()

    elif choice == '3':
        viewQueue()

    elif choice == '4':
        isQueueEmpty()

    elif choice == '5':
        print("Exiting Call Center Queue...")
        break

    else:
        print("Invalid choice! Try again.")
